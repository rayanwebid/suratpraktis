# Runtime variables. Never commit populated secrets.
SITE_URL=https://your-domain.example
OWNER_EMAIL=
# Keep 0 on standalone Cloudflare deployments. Only Sites supplies trusted identity headers.
SITES_HOSTED_AUTH=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Build/deploy environment only (not app credentials).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=
WORKER_NAME=suratpraktis
D1_DATABASE_NAME=suratpraktis-db
